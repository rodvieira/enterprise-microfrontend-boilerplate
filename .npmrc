# A single node_modules at the repository root instead of one per package.
#
# This is pnpm's hoisted layout, the same shape npm and yarn produce. It costs
# the strict isolation pnpm's default symlink layout gives for free: with every
# dependency hoisted, a package can import something it never declared and it
# resolves anyway — the "phantom dependency" problem. That matters here because
# a remote must stay extractable to its own repository (ADR-0007), and an
# undeclared import only breaks on the day someone extracts it.
#
# The guarantee is therefore enforced in CI instead of by the filesystem: the
# no-undeclared-dependencies rule in .dependency-cruiser.js fails the build when
# a module imports a package its own package.json does not list. See ADR-0011.
node-linker=hoisted
hoist-workspace-packages=true
