import { ModuleFederationPlugin } from '@module-federation/enhanced/rspack';
import { defineConfig } from '@rspack/cli';
import { rspack } from '@rspack/core';

const isDev = process.env.NODE_ENV !== 'production';

export default defineConfig({
  mode: isDev ? 'development' : 'production',
  entry: { main: './src/index.tsx' },
  output: {
    // Module Federation requires a fully-qualified public path so the shell
    // resolves this remote's exposed modules and shared chunks correctly.
    publicPath: 'auto',
  },
  resolve: {
    extensions: ['.tsx', '.ts', '.jsx', '.js'],
  },
  module: {
    rules: [
      {
        test: /\.[jt]sx?$/,
        exclude: /node_modules/,
        use: {
          loader: 'builtin:swc-loader',
          options: {
            jsc: {
              parser: { syntax: 'typescript', tsx: true },
              transform: { react: { runtime: 'automatic' } },
            },
          },
        },
        type: 'javascript/auto',
      },
      {
        // Same pattern every remote in this repository uses:
        // https://tailwindcss.com/docs/installation/framework-guides/rspack/react
        test: /\.css$/,
        use: ['postcss-loader'],
        type: 'css',
      },
    ],
  },
  plugins: [
    new rspack.HtmlRspackPlugin({ template: './index.html' }),
    new ModuleFederationPlugin({
      name: '{{name}}',
      filename: 'remoteEntry.js',
      // A kebab-case name (this repository's convention) is not a valid JS
      // identifier, but Module Federation's default 'var' library type
      // requires one for the exposed global. `library.name` decouples that
      // internal variable name from `name` (which stays kebab-case, and is
      // what remotes.dev.json / loadRemote() actually key off) — found by
      // running a generated app's real `rspack build`, not by inspecting
      // apps/dashboard or apps/admin, whose names happen to need no such fix.
      library: { type: 'var', name: '{{federationLibraryName}}' },
      exposes: {
        './App': './src/exposed/App.tsx',
      },
      shared: {
        react: { singleton: true, requiredVersion: '{{reactVersion}}' },
        'react-dom': { singleton: true, requiredVersion: '{{reactDomVersion}}' },
        'react-router': { singleton: true, requiredVersion: '{{reactRouterVersion}}' },
      },
    }),
  ],
  devServer: {
    port: {{port}},
    open: false,
    hot: true,
    historyApiFallback: true,
    // Module Federation loads this remote's manifest and remoteEntry.js
    // cross-origin from the shell. Without this, the browser's CORS policy
    // blocks the fetch outright — the same requirement every remote in this
    // repository already has.
    headers: { 'Access-Control-Allow-Origin': '*' },
  },
});
