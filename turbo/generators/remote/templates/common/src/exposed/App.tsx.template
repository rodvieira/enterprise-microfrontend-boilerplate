import type { RemoteAppProps } from '{{contractImport}}';
import { PlaceholderPanel } from '../internal/placeholder/placeholder-panel';
import '../internal/styles.css';

/**
 * What the shell mounts at `{{routePath}}` (via RemoteRegion, "{{name}}/App").
 * This app's public exposed surface — everything else lives in `internal/`.
 * Generated by `pnpm turbo gen remote`; this is placeholder content, not a
 * real feature yet — replace <PlaceholderPanel> with this remote's own UI.
 *
 * The styles.css import matters *here*, not only in bootstrap.tsx: when the
 * shell loads this module via federation, it fetches only the chunks in
 * `./App`'s own dependency graph — bootstrap.tsx's chunk is never
 * requested. See docs/USAGE.md's "Remotes" section for the full story.
 *
 * Everything that crosses the boundary arrives as a prop: the session the
 * orchestrator resolved, and the bus it owns. Nothing is read from a shared
 * module or a React context reaching across builds, which is what lets this
 * app move to its own repository without changing a line.
 */
export function App({ basePath, session, bus }: RemoteAppProps) {
  const { user, isAuthenticated } = session;

  const announce = () => {
    // The orchestrator relays this to every other remote it composes,
    // including tabs of the same app. Replace with a topic this app owns.
    bus.publish('{{name}}:hello', { from: '{{name}}' });
  };

  return (
    <div className="flex flex-col gap-6 p-6" data-base-path={basePath}>
      <header>
        <h1 className="text-xl font-medium text-(--color-text)">{{title}}</h1>
        <p className="text-sm text-(--color-text-muted)">
          {isAuthenticated && user ? `Signed in as ${user.name}` : 'Not signed in'}
        </p>
      </header>
      <PlaceholderPanel label="{{title}}" onAnnounce={announce} />
    </div>
  );
}

/**
 * createFederationLoader (apps/shell/src/internal/federation/loader.ts)
 * requires a default export.
 */
export default App;
