# Resolves every @enterprise-mfe/* package from GitHub Packages instead of
# the public npm registry (research D5, package-publish-contract.md).
#
# GITHUB_TOKEN must be a token with read:packages scope for this project's
# GitHub org/user, exported in the shell this runs in. Generated by
# `pnpm turbo gen remote` — this file does not itself publish or
# authenticate anything; it only tells npm/pnpm where to look.
@enterprise-mfe:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
