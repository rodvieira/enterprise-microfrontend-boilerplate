{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/config-typescript/tsconfig.react.json",
  "include": [
    "apps/*/src/**/*",
    "apps/*/tests/**/*",
    "apps/*/*.config.ts",
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "scripts/**/*",
    "*.config.ts",
    "*.setup.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
