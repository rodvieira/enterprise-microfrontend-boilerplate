# ── Federation ────────────────────────────────────────────────
# Which environment's remote manifest to use. See apps/shell/src/federation/manifest.ts
# Values: dev | staging | production
FEDERATION_ENV=dev

# ── Auth (not connected by default — see docs/how-to-connect-sso.md) ──
# packages/auth ships a stub (in-memory fake user) until these are filled in
# and provider.tsx is swapped to a real OIDC client. Any OIDC-compliant
# provider (Okta, Entra ID, Auth0, Keycloak, Google Workspace) works through
# these same three variables — no per-provider code needed.
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_REDIRECT_URI=http://localhost:3000/callback

# ── Telemetry (optional) ─────────────────────────────────────
TELEMETRY_ENDPOINT=
