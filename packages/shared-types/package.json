{
  "name": "@enterprise-mfe/shared-types",
  "version": "0.0.0",
  "description": "TypeScript contracts shared between the shell and every remote.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@enterprise-mfe/config-typescript": "workspace:*",
    "vitest": "^4.1.10"
  }
}
